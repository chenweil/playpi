{
  "name": "playpi-minimal-footer",
  "version": "0.3.1",
  "description": "Pi Minimal Footer - 3 行式自定义 footer:第 1 行目录路径与 git 分支、第 2 行 sessionID、第 3 行上下文进度条、由 token-rate 发布的缓存命中率(CH)与输出速率(t/s)、provider/model(thinking)/goal(模型名在行尾)。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "footer",
    "statusline",
    "minimal-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenweil/playpi.git",
    "directory": "extensions/minimal-footer"
  },
  "homepage": "https://github.com/chenweil/playpi#readme",
  "bugs": {
    "url": "https://github.com/chenweil/playpi/issues"
  },
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0 <2.0.0",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": ["./index.ts"]
  }
}
