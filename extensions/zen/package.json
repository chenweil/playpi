{
  "name": "playpi-zen",
  "version": "0.2.0",
  "description": "Pi Zen - 禅模式展示层扩展:只显示结果,思考块、工具行、非最终 assistant 消息全部隐藏,出问题才显示。仅展示层,不影响 /export /share / 会话存储。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "zen",
    "presentation",
    "minimal-ui",
    "collapsed-thinking"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenweil/playpi.git",
    "directory": "extensions/zen"
  },
  "homepage": "https://github.com/chenweil/playpi#readme",
  "bugs": {
    "url": "https://github.com/chenweil/playpi/issues"
  },
  "files": [
    "index.ts",
    "lib/*.ts",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.0",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": ["./index.ts"]
  }
}