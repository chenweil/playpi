{
  "name": "playpi",
  "version": "0.3.1",
  "description": "Pi extensions playground. Ships extensions/zen - a presentation-layer toggle that shows results only (thinking, tool rows and non-final assistant messages hidden), with an animated fish working indicator - and extensions/token-rate - a statusline extension that publishes the latest assistant message's output tokens/s and cache-hit rate via ctx.ui.setStatus() without taking over the footer.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "zen",
    "minimal-ui",
    "endbell",
    "token-rate",
    "statusline",
    "cache-hit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenweil/playpi.git"
  },
  "homepage": "https://github.com/chenweil/playpi#readme",
  "bugs": {
    "url": "https://github.com/chenweil/playpi/issues"
  },
  "files": [
    "extensions/zen/index.ts",
    "extensions/zen/lib/*.ts",
    "!extensions/zen/lib/*.test.ts",
    "extensions/zen/LICENSE",
    "extensions/zen/README.md",
    "extensions/zen/package.json",
    "extensions/endbell/index.ts",
    "extensions/endbell/README.md",
    "extensions/endbell/LICENSE",
    "extensions/endbell/package.json",
    "extensions/token-rate/index.ts",
    "extensions/token-rate/lib/token-rate.ts",
    "extensions/token-rate/LICENSE",
    "extensions/token-rate/README.md",
    "extensions/token-rate/package.json",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0 <2.0.0",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test extensions/*/lib/*.test.ts tests/*.test.ts",
    "smoke": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --strict --target es2022 --lib es2023 --module esnext --moduleResolution bundler --allowImportingTsExtensions --skipLibCheck --types node extensions/*/index.ts extensions/*/lib/*.ts tests/*.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/zen/index.ts",
      "./extensions/token-rate/index.ts",
      "./extensions/endbell/index.ts"
    ]
  }
}
